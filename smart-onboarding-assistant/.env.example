# Smart Developer Onboarding Assistant — Environment Variables
# Copy this file to .env and fill in the values.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Smart Developer Onboarding Assistant"
APP_VERSION="0.1.0"
DEBUG=false

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Groq (required only when llm_provider="groq") ────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Available models (active on this key): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.3

# ── OpenAI (required only when llm_provider="openai") ────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# ── Repository Analysis ───────────────────────────────────────────────────────
# Temporary directory used when cloning remote GitHub repositories
CLONE_BASE_DIR=/tmp/onboarding_repos

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all
CORS_ORIGINS=["*"]
